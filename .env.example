# 复制本文件为 .env 并填入真实值
# 阿里云百炼（DashScope）大模型配置
DASHSCOPE_API_KEY=你的DashScope密钥
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# 高德开放平台 Web 服务 Key
AMAP_KEY=你的高德Key

# 聚合数据 Key（交通票务查询）
JUHE_KEY=你的聚合数据Key

# 关闭 openai-agents 的 tracing 上报
OPENAI_AGENTS_DISABLE_TRACING=1
